# Copy to .env; keep the real key only in .env (never commit it).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_REQUESTS=8
DEEPSEEK_MAX_OUTPUT_TOKENS=10000
DEEPSEEK_THINKING=disabled
# Optional CNY prices per million tokens; leave blank until checked.
DEEPSEEK_INPUT_PRICE=
DEEPSEEK_OUTPUT_PRICE=
