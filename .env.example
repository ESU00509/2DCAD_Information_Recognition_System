# Copy to .env; keep the real key only in .env (never commit it).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_REQUESTS=8
DEEPSEEK_MAX_OUTPUT_TOKENS=10000
DEEPSEEK_THINKING=disabled
# Optional CNY prices per million tokens; leave blank until checked.
DEEPSEEK_INPUT_PRICE=
DEEPSEEK_OUTPUT_PRICE=
# YOLO weights that locate the three views; required for region locating.
THREE_VIEW_WEIGHTS=yolo/three_view/model.pt
# Optional detector overrides.
# THREE_VIEW_CONF=0.1
# THREE_VIEW_DEVICE=cpu
